<?xml version="1.0" encoding="utf-8"?>
<!--
  API 26 以下的回退启动图标（adaptive-icon 只有 v26 变体，minSdk 是 23）。
  同一个沙漏造型，深底白形，与 mipmap-anydpi-v26/ic_launcher.xml 视觉一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 深底：铺满整个 viewport -->
    <path
        android:fillColor="#12151C"
        android:pathData="M0,0 h108 v108 h-108 z" />

    <!-- 上横梁 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,30 h36 a2,2 0 0 1 0,4 h-36 a2,2 0 0 1 0,-4 z" />

    <!-- 下横梁 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,74 h36 a2,2 0 0 1 0,4 h-36 a2,2 0 0 1 0,-4 z" />

    <!-- 沙漏外形 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round"
        android:pathData="M40,34 L40,42 L52,54 L40,66 L40,74 M68,34 L68,42 L56,54 L68,66 L68,74" />

    <!-- 上半部分沙子 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M43,38 L65,38 L56,50 L52,50 z" />

    <!-- 下半部分沙堆 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,70 L64,70 L56,60 L52,60 z" />
