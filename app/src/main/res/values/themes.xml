<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose 负责全部界面。这里只提供 Activity 启动到首帧之间的系统窗口底色，
      取值与 theme/Colour.kt 里的背景底色一致，避免启动瞬间白屏。
    -->
    <style name="Theme.Chongleme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
