<?xml version="1.0" encoding="utf-8"?>
<!--
  记录是很私人的数据：不允许云备份，也不参与换机迁移。
  应用内的「导出备份」是唯一的数据搬移方式，由用户自己掌控文件去向。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
