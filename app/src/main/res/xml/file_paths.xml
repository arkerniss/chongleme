<?xml version="1.0" encoding="utf-8"?>
<!--
  备份出来的 ZIP 放在 getExternalFilesDir(null)/backup/ 下，用户可用文件管理器
  直接拷走，不需要任何存储权限。

  拍照的中转文件放在 cacheDir/capture/ 下：TakePicture 要求调用方先给出一个可写的
  content:// URI，相机 App 把原图写进去，我们读完立刻降采样转码并删除原图。
  没有下面这条 <cache-path>，FileProvider 会以「文件不在任何已声明的路径下」拒绝生成 URI。
-->
<paths>
    <external-files-path
        name="backup"
        path="backup/" />

    <cache-path
        name="capture"
        path="capture/" />
</paths>
